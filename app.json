                "en": "IP address or hostname",
                "nl": "IP-adres of hostnaam",
                "de": "IP-Adresse oder Hostname"
              },
              "hint": {
                "en": "Use the local address of the device.",
                "nl": "Gebruik het lokale adres van het apparaat.",
                "de": "Verwende die lokale Adresse des Geräts."
              }
            },
            {
              "id": "username",
              "type": "text",
              "value": "admin",
              "label": {
                "en": "Username",
                "nl": "Gebruikersnaam",
                "de": "Benutzername"
              }
            },
            {
              "id": "password",
