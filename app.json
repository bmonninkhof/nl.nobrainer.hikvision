                "en": "RTSP stream",
                "nl": "RTSP-stream",
                "de": "RTSP-Stream"
              },
              "hint": {
                "en": "Automatic prefers the lower-resolution H.264 substream for reliable Homey Live video.",
                "nl": "Automatisch geeft voor betrouwbare Homey Live-video de voorkeur aan de H.264-substream met lagere resolutie.",
                "de": "Automatisch bevorzugt für zuverlässiges Homey-Live-Video den H.264-Substream mit niedrigerer Auflösung."
              },
              "values": [
                {
                  "id": "automatic",
                  "label": {
                    "en": "Automatic (recommended)",
                    "nl": "Automatisch (aanbevolen)",
                    "de": "Automatisch (empfohlen)"
                  }
                },
                {
                  "id": "substream",
                  "label": {
                    "en": "Substream",
                    "nl": "Substream",
                    "de": "Substream"
                  }
                },
                {
                  "id": "main",
                  "label": {
                    "en": "Main stream",
                    "nl": "Hoofdstream",
                    "de": "Hauptstream"
                  }
                }
              ]
            },
            {
              "id": "rtsp_only",
              "type": "checkbox",
              "value": false,
              "label": {
                "en": "RTSP-only mode",
                "nl": "Alleen RTSP gebruiken",
                "de": "Nur-RTSP-Modus"
              },
              "hint": {
                "en": "Use this only when a door station has working Live video but broken ISAPI. Snapshots, events and connection checks are disabled.",
                "nl": "Gebruik dit alleen wanneer een deurstation wel Live-video maar geen werkende ISAPI heeft. Momentopnamen, gebeurtenissen en verbindingscontroles worden uitgeschakeld.",
                "de": "Nur verwenden, wenn eine Türstation Live-Video, aber kein funktionierendes ISAPI hat. Schnappschüsse, Ereignisse und Verbindungsprüfungen werden deaktiviert."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Hikvision connection",
            "nl": "Hikvision-verbinding",
            "de": "Hikvision-Verbindung"
          },
          "children": [
            {
              "id": "address",
              "type": "text",
              "value": "0.0.0.0",
