{
  "title": {
    "en": "Go to PTZ preset",
    "nl": "Ga naar PTZ-preset",
    "de": "PTZ-Voreinstellung aufrufen"
  },
  "titleFormatted": {
    "en": "Move camera [[channel]] to PTZ preset [[preset]]",
    "nl": "Beweeg camera [[channel]] naar PTZ-preset [[preset]]",
    "de": "Kamera [[channel]] zur PTZ-Voreinstellung [[preset]] bewegen"
  },
  "hint": {
    "en": "The preset must already be stored in the camera or NVR.",
    "nl": "De preset moet al in de camera of NVR zijn opgeslagen.",
