      "title": { "en": "Camera channel", "nl": "Camerakanaal", "de": "Kamerakanal" },
      "placeholder": {
        "en": "Select a PTZ channel",
        "nl": "Selecteer een PTZ-kanaal",
        "de": "PTZ-Kanal auswählen"
      }
    },
    {
      "name": "preset",
      "type": "autocomplete",
      "title": { "en": "Stored preset", "nl": "Opgeslagen preset", "de": "Gespeicherte Voreinstellung" },
      "placeholder": {
        "en": "Select a stored preset",
        "nl": "Selecteer een opgeslagen preset",
        "de": "Gespeicherte Voreinstellung auswählen"
      }
    }
