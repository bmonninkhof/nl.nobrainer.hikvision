{
  "title": { "en": "Set relative PTZ", "nl": "Relatieve PTZ instellen", "de": "Relative PTZ einstellen" },
  "titleFormatted": {
    "en": "Move camera [[channel]] for [[duration]] seconds: pan [[pannumber]], tilt [[tiltnumber]], zoom [[zoomnumber]]",
    "nl": "Beweeg camera [[channel]] [[duration]] seconden: pan [[pannumber]], tilt [[tiltnumber]], zoom [[zoomnumber]]",
    "de": "Kamera [[channel]] für [[duration]] Sekunden bewegen: Pan [[pannumber]], Tilt [[tiltnumber]], Zoom [[zoomnumber]]"
  },
  "hint": {
    "en": "Relative values range from -100 to 100.",
    "nl": "Relatieve waarden lopen van -100 tot 100.",
