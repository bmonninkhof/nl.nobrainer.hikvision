    { "name": "zoomnumber", "type": "number", "min": -100, "max": 100, "step": 0.1, "placeholder": { "en": "Zoom", "nl": "Zoom", "de": "Zoom" } },
    { "name": "duration", "type": "number", "min": 0.1, "max": 10, "step": 0.1, "placeholder": { "en": "Duration in seconds", "nl": "Duur in seconden", "de": "Dauer in Sekunden" } },
    { "name": "channel", "type": "autocomplete", "title": { "en": "Camera channel", "nl": "Camerakanaal", "de": "Kamerakanal" }, "placeholder": { "en": "Select a PTZ channel", "nl": "Selecteer een PTZ-kanaal", "de": "PTZ-Kanal auswählen" } }
  ]
}
